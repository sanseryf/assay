{
  "name": "assay-ui",
  "private": true,
  "version": "1.3.0",
  "description": "Browser bundle for the Assay web UI",
  "scripts": {
    "build": "esbuild src/main.js --bundle --minify --format=iife --target=es2020 --outfile=../src/assay/static/app.js",
    "watch": "esbuild src/main.js --bundle --format=iife --target=es2020 --outfile=../src/assay/static/app.js --watch",
    "smoke": "node smoke.mjs"
  },
  "dependencies": {
    "@codemirror/lang-json": "^6.0.2",
    "@codemirror/lint": "^6.8.5",
    "@codemirror/state": "^6.5.2",
    "@codemirror/view": "^6.38.1",
    "codemirror": "^6.0.1",
    "jsonc-parser": "^3.3.1"
  },
  "devDependencies": {
    "esbuild": "^0.25.0",
    "puppeteer-core": "^25.19.0"
  },
  "allowScripts": {
    "esbuild@0.25.12": true
  }
}
